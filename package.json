{
  "name": "@suntion/dsh-tool-gate",
  "version": "0.1.1",
  "keywords": ["dsh-plugin"],
  "description": "Per-session, per-plugin tool gating for DeepSeek Harness: at session start, choose which enabled plugins may contribute tools; disabled plugins' tools are never injected into that session's prompt.",
  "author": "Suntion",
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SunYanbox/DSHToolGate"
  },
  "homepage": "https://www.npmjs.com/package/@suntion/dsh-tool-gate",
  "bugs": {
    "url": "https://github.com/SunYanbox/DSHToolGate/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["react"],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-alpha.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.5",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "react": { "optional": true }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
